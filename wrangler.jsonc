{
  "name": "gestionale-cantieri",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "STATO", "class_name": "Stato" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Stato"] }]
}
